# Text files are stored with LF and checked out with the machine's own line endings: LF on Linux, CRLF on Windows.
* text=auto

# Shell scripts run in Linux even from a Windows checkout: always LF.
*.sh text eol=lf

# Example data is bundled byte for byte: no line-ending changes on checkout.
JuliaSynth/ExampleData/** -text

*.png binary
*.ico binary
*.ttf binary
