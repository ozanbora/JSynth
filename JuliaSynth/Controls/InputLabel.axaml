<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:jsModel="clr-namespace:JuliaSynth.Model"
             x:Class="JuliaSynth.Controls.InputLabel"
             x:DataType="jsModel:Node"
             HorizontalAlignment="Left"
             IsVisible="{Binding Path=HasPurpose}"
             >
  <!-- An input's name: the one given (its variable in the script), or, for a number, the parameter it is wired into. -->
  <TextBlock Classes="purpose"
             Margin="0"
             Text="{Binding Path=Purpose}"
             ToolTip.Tip="{Binding Path=PurposeTip}"
             />
</UserControl>
