<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JuliaSynth.Controls.BreakpointEditor"

             xmlns:jsViewModels="clr-namespace:JuliaSynth.ViewModels"

             x:DataType="jsViewModels:BreakpointEditing"
             Width="320"
             >
  <!-- A wire's breakpoint: when it pauses, on or off, or removed. -->
  <StackPanel Spacing="6">
    <TextBlock Text="{Binding Path=Title}"
               FontWeight="SemiBold"
               TextWrapping="Wrap"/>
    <RadioButton GroupName="When"
                 Content="Every time a value comes"
                 IsChecked="{Binding Path=EveryTime}"/>
    <RadioButton GroupName="When"
                 Content="When the value is such that"
                 IsChecked="{Binding Path=OnCondition}"/>
    <TextBox x:Name="ConditionBox"
             Margin="24 0 0 0"
             FontFamily="{StaticResource CodeFont}"
             FontSize="12"
             PlaceholderText="x &gt; 0.5"
             IsEnabled="{Binding Path=OnCondition}"
             Text="{Binding Path=Condition}"/>
    <TextBlock Margin="24 0 0 0"
               FontSize="11"
               Opacity="0.6"
               TextWrapping="Wrap"
               Text="x is the value on the wire: Julia, true or false. A condition that fails doesn't pause."/>
    <StackPanel Orientation="Horizontal" Spacing="12">
      <CheckBox Content="On"
                IsChecked="{Binding Path=On}"
                ToolTip.Tip="Off, it doesn't pause, and keeps its condition"/>
      <Button Content="Remove"
              Click="Remove_Click"/>
    </StackPanel>
  </StackPanel>
</UserControl>
