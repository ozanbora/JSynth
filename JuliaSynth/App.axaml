<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JuliaSynth.App"
             RequestedThemeVariant="Default">
             <!-- "Default" follows the system's light or dark; View → Theme picks one (see MainViewModel.ApplyTheme). -->

  <Application.Styles>
    <!-- Julia's colours on quiet neutrals: its purple for what is chosen, green to run, red to stop, blue for ports. -->
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light"
                               Accent="#9558B2"
                               RegionColor="#FFFFFF"
                               AltHigh="#FFFFFF"
                               AltMediumHigh="#CCFFFFFF"
                               AltMedium="#99FFFFFF"
                               AltMediumLow="#66FFFFFF"
                               AltLow="#33FFFFFF"
                               BaseHigh="#1E1B24"
                               BaseMediumHigh="#CC1E1B24"
                               BaseMedium="#991E1B24"
                               BaseMediumLow="#661E1B24"
                               BaseLow="#261E1B24"
                               ChromeAltLow="#1E1B24"
                               ChromeLow="#F1F0F4"
                               ChromeMediumLow="#F6F5F8"
                               ChromeMedium="#ECEAF0"
                               ChromeHigh="#D3D0DA"
                               ChromeGray="#6E6A78"
                               ListLow="#121E1B24"
                               ListMedium="#241E1B24"
                               ErrorText="#CB3C33"/>
        <ColorPaletteResources x:Key="Dark"
                               Accent="#B47FD0"
                               RegionColor="#1E1D22"
                               AltHigh="#17161A"
                               AltMediumHigh="#CC17161A"
                               AltMedium="#9917161A"
                               AltMediumLow="#6617161A"
                               AltLow="#3317161A"
                               BaseHigh="#ECEAF0"
                               BaseMediumHigh="#CCECEAF0"
                               BaseMedium="#99ECEAF0"
                               BaseMediumLow="#66ECEAF0"
                               BaseLow="#29ECEAF0"
                               ChromeAltLow="#ECEAF0"
                               ChromeLow="#17161A"
                               ChromeMediumLow="#28272D"
                               ChromeMedium="#232228"
                               ChromeHigh="#55525C"
                               ChromeGray="#9A96A3"
                               ListLow="#14ECEAF0"
                               ListMedium="#26ECEAF0"
                               ErrorText="#E2625A"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://JuliaSynth/Styles/Nodes.axaml" />
    <StyleInclude Source="avares://JuliaSynth/Styles/Branding.axaml" />
  </Application.Styles>
  <Application.Resources>
    <!-- Type: Inter for the interface; JuliaMono, made for Julia, for code, values and types (it has the maths
         symbols too); Noto Sans Math for the nodes' big symbols. All free, and bundled, so the same everywhere. -->
    <FontFamily x:Key="UiFont">fonts:Inter#Inter, $Default</FontFamily>
    <FontFamily x:Key="CodeFont">avares://JuliaSynth/Assets/Fonts/JuliaMono#JuliaMono, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
    <FontFamily x:Key="NotoSansMath">avares://JuliaSynth/Assets/Fonts#Noto Sans Math</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter, $Default</FontFamily>
    <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>

    <!-- Line icons, on a 24 × 24 grid (see Controls.Icon). -->
    <StreamGeometry x:Key="IconMenu">M4,7 H20 M4,12 H20 M4,17 H20</StreamGeometry>
    <StreamGeometry x:Key="IconSidebar">M5,4 H19 A2,2 0 0 1 21,6 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 V6 A2,2 0 0 1 5,4 Z M9.5,4 V20</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M12,5 V19 M5,12 H19</StreamGeometry>
    <StreamGeometry x:Key="IconOpen">M3,8 A2,2 0 0 1 5,6 H9.5 L11.5,8 H19 A2,2 0 0 1 21,10 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z</StreamGeometry>
    <StreamGeometry x:Key="IconExamples">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z</StreamGeometry>
    <StreamGeometry x:Key="IconLibrary">M4,4 H8 V20 H4 Z M10,4 H14 V20 H10 Z M16,5.5 L19.5,4.5 L22,19 L18.5,20 Z</StreamGeometry>
    <StreamGeometry x:Key="IconParameters">M4,7 H20 M4,17 H20 M9,4 V10 M15,14 V20</StreamGeometry>
    <StreamGeometry x:Key="IconOutput">M5,4 H19 A2,2 0 0 1 21,6 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 V6 A2,2 0 0 1 5,4 Z M7,9 L10,12 L7,15 M12,15 H17</StreamGeometry>
    <StreamGeometry x:Key="IconNewWindow">M9,3 H19 A2,2 0 0 1 21,5 V15 A2,2 0 0 1 19,17 H17 M5,7 H13 A2,2 0 0 1 15,9 V19 A2,2 0 0 1 13,21 H5 A2,2 0 0 1 3,19 V9 A2,2 0 0 1 5,7 Z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M7,7 L17,17 M17,7 L7,17</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M5,12.5 L10,17.5 L19,7</StreamGeometry>
    <StreamGeometry x:Key="IconDash">M6,12 H18</StreamGeometry>
  </Application.Resources>
</Application>
