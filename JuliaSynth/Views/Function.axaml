<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             x:Class="JuliaSynth.Views.Function"

             xmlns:converters="clr-namespace:Avalonia.Markup.Xaml.Converters;assembly=Avalonia.Markup.Xaml"
             xmlns:jsModel ="clr-namespace:JuliaSynth.Model;assembly=JuliaSynth"
             xmlns:jsControls="clr-namespace:JuliaSynth.Controls"
             xmlns:jsDetails="clr-namespace:JuliaSynth.Views.Details"

             x:DataType="jsModel:Function"
             >
  <Design.DataContext>
    <jsModel:Function />
  </Design.DataContext>

  <UserControl.Resources>
    <converters:ColorToBrushConverter x:Key="ToBrushConverter"/>
  </UserControl.Resources>

  <Border Background="{Binding Path=Color, Converter={StaticResource ToBrushConverter}}"
          CornerRadius="8"
          Classes="node"
          BorderBrush="Black"
          BorderThickness="1"
          >
    <Grid ShowGridLines="False">

      <Grid.RowDefinitions>
        <RowDefinition Height="30"/>
        <RowDefinition Height="50"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Grid.Row="0"
                 Grid.RowSpan="2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 FontFamily="{StaticResource NotoSansMath}"
                 FontSize="64"
                 Text="𝒇"
                 />

      <StackPanel Grid.Row="0"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">

        <TextBlock Text="⚠"
                   VerticalAlignment="Center"
                   Margin="0 0 4 0"
                   Foreground="Gold"
                   IsVisible="{Binding Path=Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                   ToolTip.Tip="{Binding Path=Error}"
                   />

        <Button Content="Ξ"
                FontFamily="{StaticResource NotoSansMath}"
              >
          <Button.Flyout>
            <Flyout Placement="Top"
                    ShowMode="Transient"
                    >
              <jsDetails:Function/>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button Content="𝑖"
                FontFamily="{StaticResource NotoSansMath}"
              />

        <Button Content="X"
                FontFamily="{StaticResource NotoSansMath}"
                />

      </StackPanel>

      <!-- Output -->
      <jsControls:Connector Grid.Row="1"
                     Grid.Column="1"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     ZIndex="3"
                     Margin="0 0 -12 0"/>

      <StackPanel Grid.Row="1"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  ToolTip.Tip="{Binding Path=Code}"
                  >
        <TextBlock FontSize="18"
                   Text="{Binding Path=Name}"
                   />
        <TextBlock FontFamily="{StaticResource NotoSansMath}"
                   FontStyle="Italic"
                   FontSize="12"
                   VerticalAlignment="Bottom"
                   Margin="2 0 0 2"
                   Text="{Binding Path=ReturnType, StringFormat=::\{0\}}"
                   />
      </StackPanel>

      <!-- Inputs, one per parameter -->
      <ItemsControl Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    ItemsSource="{Binding Path=Parameters}"
                    ClipToBounds="False"
                    >
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="jsModel:Parameter">
            <Grid Height="20">
              <jsControls:Connector HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ZIndex="3"
                                    Margin="-12 0 0 0"/>
              <TextBlock HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Margin="16 0 8 0"
                         FontFamily="{StaticResource NotoSansMath}"
                         FontStyle="Italic"
                         FontSize="12"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Path=Signature}"
                         ToolTip.Tip="{Binding Path=Signature}"
                         />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </Grid>
  </Border>

</UserControl>
