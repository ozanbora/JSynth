<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JuliaSynth.Views.Details.WatchNode"
             Classes="details"
             xmlns:jsModel ="clr-namespace:JuliaSynth.Model;assembly=JuliaSynth"
             xmlns:jsDetails="clr-namespace:JuliaSynth.Views.Details"
             x:DataType="jsModel:WatchNode"
             Width="480"
             >

  <!-- How each file is read, as for Files; then how the folder is watched. -->
  <StackPanel Spacing="10">
    <jsDetails:FilesNode/>

    <Grid RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto"
          ColumnDefinitions="auto,*"
          >
      <Label Grid.Row="0"
             Grid.Column="0"
             VerticalAlignment="Center"
             Content="Already there"
             />
      <CheckBox Grid.Row="0"
                Grid.Column="1"
                Content="Files in the folder at the start go first"
                IsChecked="{Binding Path=ExistingFirst}"
                ToolTip.Tip="Ticked: the files already in the folder are worked through first, then new ones as they come. Not ticked: only files written after the start."
                />

      <Label Grid.Row="1"
             Grid.Column="0"
             VerticalAlignment="Center"
             Content="Order"
             />
      <ComboBox Grid.Row="1"
                Grid.Column="1"
                Width="150"
                SelectedValue="{Binding Path=Order}"
                ItemsSource="{x:Static jsModel:WatchNode.Orders}"
                ToolTip.Tip="The order of files waiting together: by name (timestamped names, frame-0001, ...), or by the time they were written."
                />

      <Label Grid.Row="2"
             Grid.Column="0"
             VerticalAlignment="Center"
             Content="Behind"
             />
      <CheckBox Grid.Row="2"
                Grid.Column="1"
                Content="Latest only: skip to the newest file"
                IsChecked="{Binding Path=LatestOnly}"
                ToolTip.Tip="When files come faster than they are worked through, and several are waiting: only the newest is, the others are passed over. For live data, where only the present matters (where aircraft are now, say). Not ticked: every file, in turn."
                />

      <TextBlock Grid.Row="3"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 Margin="0 8 0 0"
                 FontWeight="SemiBold"
                 Text="Where new files come from (optional)"
                 />

      <Label Grid.Row="4"
             Grid.Column="0"
             VerticalAlignment="Center"
             Content="Replay"
             />
      <Grid Grid.Row="4"
            Grid.Column="1"
            ColumnDefinitions="*,auto"
            >
        <TextBox Grid.Column="0"
                 Text="{Binding Path=ReplayFolder}"
                 PlaceholderText="A folder of recorded files"
                 ToolTip.Tip="While the stream runs, JuliaSynth copies the matching files of this folder into the watched one, one at a time, as a sensor would write them: for trying a design without the sensor."
                 />
        <Button Grid.Column="1"
                Margin="4 0 0 0"
                Content="Browse…"
                Click="BrowseReplay_Click"
                />
      </Grid>

      <Label Grid.Row="5"
             Grid.Column="0"
             VerticalAlignment="Center"
             Content="Rate"
             IsVisible="{Binding Path=Replays}"
             />
      <StackPanel Grid.Row="5"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6"
                  IsVisible="{Binding Path=Replays}"
                  >
        <NumericUpDown Width="130"
                       Minimum="0.1"
                       Maximum="100"
                       Increment="1"
                       FormatString="0.##"
                       Value="{Binding Path=ReplayRate}"
                       />
        <TextBlock VerticalAlignment="Center"
                   Text="files a second"
                   />
      </StackPanel>

      <Label Grid.Row="6"
             Grid.Column="0"
             VerticalAlignment="Center"
             Content="Fetch"
             />
      <TextBox Grid.Row="6"
               Grid.Column="1"
               Text="{Binding Path=FetchUrl}"
               PlaceholderText="A web address answering with data (optional)"
               ToolTip.Tip="While the stream runs, JuliaSynth fetches this address again and again and saves each answer as a new file in the watched folder, named by the time: a web service as the sensor (live aircraft positions, say)."
               />

      <Label Grid.Row="7"
             Grid.Column="0"
             VerticalAlignment="Center"
             Content="Every"
             IsVisible="{Binding Path=Fetches}"
             />
      <StackPanel Grid.Row="7"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6"
                  IsVisible="{Binding Path=Fetches}"
                  >
        <NumericUpDown Width="130"
                       Minimum="1"
                       Maximum="86400"
                       Increment="5"
                       FormatString="0.#"
                       Value="{Binding Path=FetchEvery}"
                       ToolTip.Tip="How often to fetch. Web services limit how often they may be asked: OpenSky, 400 times a day without an account."
                       />
        <TextBlock VerticalAlignment="Center"
                   Text="seconds"
                   />
      </StackPanel>
    </Grid>
  </StackPanel>

</UserControl>
