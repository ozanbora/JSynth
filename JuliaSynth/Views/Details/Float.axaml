<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             
             x:Class="JuliaSynth.Views.Details.Float"
             Classes="details"
             
             xmlns:jsModel ="clr-namespace:JuliaSynth.Model;assembly=JuliaSynth"
             xmlns:jsConverters="clr-namespace:JuliaSynth.Converters"
             
             x:DataType="jsModel:Float"
             Width="400"
             
             mc:Ignorable="d"
             d:DesignHeight="300"
             >

  <Design.DataContext>
    <jsModel:Float />
  </Design.DataContext>
  
  <Grid RowDefinitions="auto,auto,auto,auto,auto,auto"
        ColumnDefinitions="auto,*"
        >

    <!-- Its name: its variable in the script, so the output says which value is which (as Julia allows: see
         ScriptGenerator.VariableFor), and its name in the parameters panel. -->
    <Label Grid.Row="0"
           Grid.Column="0"
           Content="Name"
           />
    <StackPanel Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                >
      <TextBox Width="180"
               Text="{Binding Path=PanelName, UpdateSourceTrigger=LostFocus}"
               PlaceholderText="{Binding Path=Variable}"
               ToolTip.Tip="Its variable in the script, and its name in the parameters panel. Empty: named by the script (x1, v1, A1, …)."
               />
      <TextBlock Classes="caption"
                 VerticalAlignment="Center"
                 Text="{Binding Path=Variable, StringFormat='in the script: {0}'}"
                 />
    </StackPanel>    <Grid.Resources>
      <jsConverters:DoubleToScientificString x:Key="DoubleToScientificString"/>
    </Grid.Resources>


    <Label Grid.Row="1"
           Grid.Column="0"
           VerticalAlignment="Bottom"
           Content="Bitness"
           />
    <StackPanel Grid.Row="1"
                Grid.Column="1"
                Orientation="Horizontal"
                >
      <ComboBox SelectedValue="{Binding Path=SelectedType}"
                ItemsSource="{Binding Path=PossibleTypes}"
                VerticalAlignment="Bottom"
                ToolTip.Tip="Select the number of bits you want to represent this variable."
              />

      <Label Content="Color" VerticalAlignment="Bottom"/>
      <ColorPicker Color="{Binding Path=Color}"
                   HorizontalAlignment="Left"
                   ToolTip.Tip="Select the color you want to display this node."
                   />

      <CheckBox Content="In parameters"
                Margin="12 0 0 0"
                VerticalAlignment="Center"
                IsChecked="{Binding Path=InPanel}"
                ToolTip.Tip="Set it from the parameters panel too, with a slider or a box"/>

    </StackPanel>

    <Label Grid.Row="2"
           Grid.Column="0"
           Content="Value" />

    <TextBox Grid.Row="2"
             Grid.Column="1"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Right"
             Text="{Binding Path=Value, Converter={StaticResource DoubleToScientificString}}"
                   ToolTip.Tip="This is the initial value when the application is launched. You can always update it later on from the user interface."
                   />

    <Label Grid.Row="3"
           Grid.Column="0"
           Content="Minimum"
           />

    <TextBox Grid.Row="3"
             Grid.Column="1"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Right"
             Text="{Binding Path=Min, Converter={StaticResource DoubleToScientificString}}"
             ToolTip.Tip="Minimum value will be used for validation in the user interface. By default, it is set to minimum value of bitness representation."
                   />

    <Label Grid.Row="4"
           Grid.Column="0"
           Content="Maximum"
           />

    <TextBox Grid.Row="4"
             Grid.Column="1"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Right"
             Text="{Binding Path=Max, Converter={StaticResource DoubleToScientificString}}"
             ToolTip.Tip="Maximum value will be used for validation in the user interface. By default, it is set to maximum value of bitness representation."
                   />

    <Label Grid.Row="5"
           Grid.Column="0"
           Content="Epsilon"
           />

    <TextBox Grid.Row="5"
             Grid.Column="1"
             HorizontalAlignment="Stretch"
             HorizontalContentAlignment="Right"
             IsEnabled="False"
             Text="{Binding Path=Epsilon, StringFormat=\{0:R\}}"
             ToolTip.Tip="This is machine epsilon for this bitness, i.e. smallest representable floating point number."
                   />
  </Grid>

</UserControl>
