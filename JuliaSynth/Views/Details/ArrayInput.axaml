<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             x:Class="JuliaSynth.Views.Details.ArrayInput"
             Classes="details"

             xmlns:jsModel ="clr-namespace:JuliaSynth.Model;assembly=JuliaSynth"

             x:DataType="jsModel:ArrayInput"
             Width="400"

             mc:Ignorable="d"
             d:DesignHeight="300"
             >

  <Design.DataContext>
    <jsModel:MatrixNode />
  </Design.DataContext>

  <UserControl.Resources>
  </UserControl.Resources>

  <Grid RowDefinitions="auto,auto,auto,auto"
        ColumnDefinitions="auto,*"
        >

    <Label Grid.Row="0"
           Grid.Column="0"
           Content="Elements"
           />
    <StackPanel Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal"
                >
      <ComboBox SelectedValue="{Binding Path=ElementType}"
                ItemsSource="{Binding Path=PossibleTypes}"
                VerticalAlignment="Center"
                ToolTip.Tip="Julia type of every value."
                />

      <Label Content="Color" VerticalAlignment="Center"/>
      <ColorPicker Color="{Binding Path=Color}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   ToolTip.Tip="Select the color you want to display this node."
                   />

      <CheckBox Content="In parameters"
                Margin="12 0 0 0"
                VerticalAlignment="Center"
                IsChecked="{Binding Path=InPanel}"
                ToolTip.Tip="Set it from the parameters panel too, with a slider or a box"/>
    </StackPanel>

    <Label Grid.Row="1"
           Grid.Column="0"
           VerticalAlignment="Top"
           Content="Values"
           />
    <StackPanel Grid.Row="1"
                Grid.Column="1"
                Spacing="4">
      <TextBox Height="120"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="{StaticResource CodeFont}"
               Text="{Binding Path=Text}"
               ToolTip.Tip="Julia syntax: [1.0, 2.0, 3.0] for a vector, [1 2; 3 4] for a matrix. New lines also separate rows."
               />
      <TextBlock FontSize="12"
                 Opacity="0.7"
                 TextWrapping="Wrap"
                 Text="Rows are separated by ; or new lines, values by commas or spaces."
                 />
    </StackPanel>

    <TextBlock Grid.Row="2"
               Grid.Column="1"
               Margin="0 4"
               Foreground="{DynamicResource ConsoleErrorBrush}"
               TextWrapping="Wrap"
               Text="{Binding Path=Error}"
               IsVisible="{Binding Path=Error, Converter={x:Static ObjectConverters.IsNotNull}}"
               />

    <!-- Hidden while there's an error: it would only repeat it. -->
    <Label Grid.Row="3"
           Grid.Column="0"
           VerticalAlignment="Top"
           Content="Julia"
           IsVisible="{Binding Path=Error, Converter={x:Static ObjectConverters.IsNull}}"
           />
    <Border Grid.Row="3"
            Grid.Column="1"
            IsVisible="{Binding Path=Error, Converter={x:Static ObjectConverters.IsNull}}"
            Padding="6"
            CornerRadius="4"
            Background="{DynamicResource CanvasBackgroundBrush}"
            >
      <SelectableTextBlock FontFamily="{StaticResource CodeFont}"
                           TextWrapping="Wrap"
                           MaxHeight="120"
                           Text="{Binding Path=Julia}"
                           />
    </Border>
  </Grid>

</UserControl>
