<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             xmlns:jsi="clr-namespace:JuliaSynth.Interactions"
             xmlns:jsvm="clr-namespace:JuliaSynth.ViewModels"
             xmlns:jsc="clr-namespace:JuliaSynth.Controls"
             xmlns:jsco="clr-namespace:JuliaSynth.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="JuliaSynth.Views.MainView"
             x:DataType="jsvm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <jsvm:MainViewModel/>
  </Design.DataContext>
  <Grid x:Name="MainGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="30"/>
      <RowDefinition Height="*" />
      <RowDefinition Height="50"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.Resources>
      <jsco:VectorFormatConverter x:Key="VectorConverter"/>
      <jsco:PercentConverter x:Key="PercentConverter"/>
    </Grid.Resources>
    
    <ScrollViewer Name="DesignerScrollViewer"
                  Background="White"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Grid.Row="1"
                  Grid.Column="1" Focusable="True"
                  AllowAutoHide="True"
                  Offset="{ Binding Path=ScrollViewerOffset, Mode=TwoWay}"
                  >
      <i:Interaction.Behaviors>
        <jsi:UserControlTriggerBehavior KeyModifiers="Control">
          <ia:InvokeCommandAction Command="{Binding CtrlPan}" PassEventArgsToCommand="True"/>
        </jsi:UserControlTriggerBehavior>
      </i:Interaction.Behaviors>
      <ScrollViewer.KeyBindings>

      </ScrollViewer.KeyBindings>
      <jsc:DesignerGrid ShowGridLines="False"
                        ShowCustomGridLines="True"
                        GridLineBrush="DarkGray"
                        GridLineThickness="0.5"
                        >
        <jsc:DesignerGrid.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="{Binding ElementName=ZoomSlider, Path=Value}"
                            ScaleY="{Binding ElementName=ZoomSlider, Path=Value}"/>
          </TransformGroup>
        </jsc:DesignerGrid.RenderTransform>
      </jsc:DesignerGrid>
    </ScrollViewer>
    <Grid Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" ShowGridLines="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1"
                 VerticalAlignment="Center"
                 Text="{ Binding ScrollViewerOffset, Converter={StaticResource VectorConverter} }" />
      <Slider Name="ZoomSlider"
              Value="1.0"
              Minimum="0.50"
              Maximum="5.00"
              IsSnapToTickEnabled="True"
              Ticks="0.50, 1.00, 1.25, 1.50, 2.00, 3.00, 4.00, 5.00, 8.00, 10.00"
              TickPlacement="TopLeft"
              Width="200"
              Margin="0 0 10 0"
              >
        <Slider.Styles>
          <Style Selector="Slider/template/Thumb">
            <Setter Property="ToolTip.Tip" Value="{Binding $parent[Slider].Value, Mode=OneWay, Converter={StaticResource PercentConverter}}" />
            <Setter Property="ToolTip.Placement" Value="Top" />
            <Setter Property="ToolTip.ShowDelay" Value="0"/>
            <Setter Property="ToolTip.VerticalOffset" Value="-10" />
            <Setter Property="ToolTip.HorizontalOffset" Value="0" />
          </Style>
        </Slider.Styles>
      </Slider>
    </Grid>
  </Grid>
</UserControl>
