<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
             xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
             xmlns:jsi="clr-namespace:JuliaSynth.Interactions"
             xmlns:jsvm="clr-namespace:JuliaSynth.ViewModels"
             xmlns:jsc="clr-namespace:JuliaSynth.Controls"
             xmlns:jsinputs="clr-namespace:JuliaSynth.Views.Inputs"
             xmlns:jsco="clr-namespace:JuliaSynth.Converters"
             mc:Ignorable="d"
             d:DesignWidth="800" 
             d:DesignHeight="600"
             x:Class="JuliaSynth.Views.MainView"
             x:DataType="jsvm:MainViewModel">
  <Grid x:Name="MainGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="30"/>
      <RowDefinition Height="*" />
      <RowDefinition Height="50"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.Resources>
      <jsco:VectorFormatConverter x:Key="VectorConverter"/>
      <jsco:PercentConverter x:Key="PercentConverter"/>
    </Grid.Resources>

    <Border Grid.Row="1"
            Grid.Column="1"
            >
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Offset="{ Binding Path=ScrollViewerOffset, Mode=TwoWay}"
                    AllowAutoHide="True"
                    >
        <i:Interaction.Behaviors>
          <jsi:UserControlTriggerBehavior KeyModifiers="Control">
            <ia:InvokeCommandAction Command="{Binding CtrlPan}" PassEventArgsToCommand="True"/>
          </jsi:UserControlTriggerBehavior>
        </i:Interaction.Behaviors>

        <LayoutTransformControl>
          <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Path=SelectedZoomLevel, Mode=OneWay}"
                            ScaleY="{Binding Path=SelectedZoomLevel, Mode=OneWay}"/>
          </LayoutTransformControl.LayoutTransform>
          
          <jsc:DesignerGrid ShowGridLines="False"
                            ShowCustomGridLines="True"
                            GridLineBrush="White"
                            GridLineThickness="0.5"
                            Focusable="True"
                            Background="DarkGray"
                            Opacity="1.0"
                            >

            <i:Interaction.Behaviors>
              <jsi:UserControlMouseWheelEventTriggerBehavior KeyModifiers="Control">
                <ia:InvokeCommandAction Command="{Binding CtrlZoom}" PassEventArgsToCommand="True"/>
              </jsi:UserControlMouseWheelEventTriggerBehavior>
            </i:Interaction.Behaviors>

            <jsinputs:UnsignedInteger Grid.Row="3"
                                      Grid.Column="4"/>
          </jsc:DesignerGrid>

        </LayoutTransformControl>
        
        
      </ScrollViewer>
    </Border>
    
    <Grid Grid.Row="2" 
          Grid.Column="1" 
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          >
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RenderTransform>
        <TransformGroup>
          <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
        </TransformGroup>
      </Grid.RenderTransform>
      <TextBlock Grid.Column="1"
                 VerticalAlignment="Bottom"
                 HorizontalAlignment="Center"
                 TextAlignment="Right"
                 Width="120"
                 Text="{ Binding ScrollViewerOffset, Converter={StaticResource VectorConverter} }" />
      <Slider Name="ZoomSlider"
              Value="{Binding Path=SelectedZoomLevel, Mode=TwoWay}"
              Minimum="{Binding Path=MinZoom, Mode=OneTime}"
              Maximum="{Binding Path=MaxZoom, Mode=OneTime}"
              IsSnapToTickEnabled="True"
              Ticks="{Binding Path=ZoomLevels, Mode=OneTime}"
              TickPlacement="TopLeft"
              Width="200"
              Margin="0 10 10 0"
              >
        <Slider.Styles>
          <Style Selector="Slider/template/Thumb">
            <Setter Property="ToolTip.Tip" Value="{Binding $parent[Slider].Value, Mode=OneWay, Converter={StaticResource PercentConverter}}" />
            <Setter Property="ToolTip.Placement" Value="Top" />
            <Setter Property="ToolTip.ShowDelay" Value="0"/>
            <Setter Property="ToolTip.VerticalOffset" Value="-10" />
            <Setter Property="ToolTip.HorizontalOffset" Value="0" />
          </Style>
        </Slider.Styles>
      </Slider>
    </Grid>
  </Grid>
</UserControl>
