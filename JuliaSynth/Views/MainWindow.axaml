<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JuliaSynth.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:JuliaSynth.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="JuliaSynth.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/Icon/juliasynth.ico"
        Title="{Binding Path=Title}"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        >
        <Window.KeyBindings>
          <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding Path=ZoomIn}"/>
          <KeyBinding Gesture="Ctrl+Add" Command="{Binding Path=ZoomIn}"/>
          <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding Path=ZoomOut}"/>
          <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding Path=ZoomOut}"/>
          <KeyBinding Gesture="Ctrl+D0" Command="{Binding Path=ResetZoom}"/>
          <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding Path=ResetZoom}"/>
          <!-- While a text field has the keyboard, the design-editing ones wait (see IsTypingText). -->
          <KeyBinding Gesture="Ctrl+Z" Command="{Binding Path=Undo}"/>
          <KeyBinding Gesture="Ctrl+Y" Command="{Binding Path=Redo}"/>
          <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding Path=Redo}"/>
          <KeyBinding Gesture="Delete" Command="{Binding Path=DeleteSelected}"/>
          <KeyBinding Gesture="Ctrl+A" Command="{Binding Path=SelectAll}"/>
          <KeyBinding Gesture="Ctrl+Shift+A" Command="{Binding Path=ArrangeNodes}"/>
          <KeyBinding Gesture="Escape" Command="{Binding Path=ClearSelection}"/>
          <KeyBinding Gesture="Ctrl+C" Command="{Binding Path=Copy}"/>
          <KeyBinding Gesture="Ctrl+X" Command="{Binding Path=Cut}"/>
          <KeyBinding Gesture="Ctrl+V" Command="{Binding Path=Paste}"/>
          <KeyBinding Gesture="Ctrl+D" Command="{Binding Path=Duplicate}"/>
          <KeyBinding Gesture="F5" Command="{Binding Path=Run}"/>
          <KeyBinding Gesture="Shift+F5" Command="{Binding Path=Stop}"/>
        </Window.KeyBindings>

        <DockPanel>
          <Border DockPanel.Dock="Top"
                  Background="{DynamicResource StatusBarBackgroundBrush}"
                  BorderBrush="{DynamicResource StatusBarBorderBrush}"
                  BorderThickness="0 0 0 1">
          <Menu>
            <MenuItem Header="_File">
              <MenuItem Header="_New" InputGesture="Ctrl+N" HotKey="Ctrl+N" Click="New_Click"/>
              <MenuItem Header="_Open…" InputGesture="Ctrl+O" HotKey="Ctrl+O" Click="Open_Click"/>
              <MenuItem Header="_Save" InputGesture="Ctrl+S" HotKey="Ctrl+S" Click="Save_Click"/>
              <MenuItem Header="Save _As…" InputGesture="Ctrl+Shift+S" HotKey="Ctrl+Shift+S" Click="SaveAs_Click"/>
              <MenuItem Header="_Autosave" ToggleType="CheckBox" IsChecked="{Binding Path=AutoSave}"
                        ToolTip.Tip="Save the design a moment after each change; a design never saved is kept to open again"/>
              <Separator/>
              <!-- Filled from Examples.All -->
              <MenuItem x:Name="ExamplesMenu" Header="_Examples"/>
              <MenuItem Header="Start pa_ge" Command="{Binding Path=ShowStartPage}"/>
              <Separator/>
              <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
              <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Command="{Binding Path=Undo}"/>
              <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Command="{Binding Path=Redo}"/>
              <Separator/>
              <MenuItem Header="Cu_t" InputGesture="Ctrl+X" Command="{Binding Path=Cut}"/>
              <MenuItem Header="_Copy" InputGesture="Ctrl+C" Command="{Binding Path=Copy}"/>
              <MenuItem Header="_Paste" InputGesture="Ctrl+V" Command="{Binding Path=Paste}"/>
              <MenuItem Header="D_uplicate" InputGesture="Ctrl+D" Command="{Binding Path=Duplicate}"/>
              <Separator/>
              <MenuItem Header="_Delete" InputGesture="Delete" Command="{Binding Path=DeleteSelected}"/>
              <MenuItem Header="Select _all" InputGesture="Ctrl+A" Command="{Binding Path=SelectAll}"/>
              <MenuItem Header="A_rrange nodes" InputGesture="Ctrl+Shift+A" Command="{Binding Path=ArrangeNodes}"/>
            </MenuItem>
            <MenuItem Header="_Run">
              <MenuItem Header="_Run" InputGesture="F5" Command="{Binding Path=Run}"/>
              <MenuItem Header="_Stop" InputGesture="Shift+F5" Command="{Binding Path=Stop}"/>
              <Separator/>
              <MenuItem Header="Show _output" Command="{Binding Path=ToggleOutput}"/>
              <MenuItem Header="_Export Julia script…" Click="ExportScript_Click"/>
              <Separator/>
              <MenuItem Header="_Install missing packages…" Command="{Binding Path=InstallPackages}"/>
              <MenuItem Header="Restart _Julia" Command="{Binding Path=Restart}"/>
              <MenuItem Header="_Choose Julia…" Click="ChooseJulia_Click"/>
            </MenuItem>
          </Menu>
          </Border>
          <views:MainView />
        </DockPanel>
</Window>
