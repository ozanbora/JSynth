<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JuliaSynth.Views.WhenNode"

             xmlns:jsModel ="clr-namespace:JuliaSynth.Model;assembly=JuliaSynth"
             xmlns:jsControls="clr-namespace:JuliaSynth.Controls"

             x:DataType="jsModel:WhenNode"
             >
  <Design.DataContext>
    <jsModel:WhenNode />
  </Design.DataContext>

  <!-- Inputs: the value, and the condition on which it passes -->
  <jsControls:NodeBody Glyph="if"
                       Title="only when"
                       Info="Only when: passes the value on when the condition is true. When it is false, the nodes after it are not worked out: going through files one at a time, they keep the values they had, so an alarm keeps the first time it went off."
                       />

</UserControl>
