<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="JuliaSynth.Views.Inputs.FilesNode"

             xmlns:converters="clr-namespace:Avalonia.Markup.Xaml.Converters;assembly=Avalonia.Markup.Xaml"
             xmlns:jsModel ="clr-namespace:JuliaSynth.Model;assembly=JuliaSynth"
             xmlns:jsControls="clr-namespace:JuliaSynth.Controls"
             xmlns:jsDetails="clr-namespace:JuliaSynth.Views.Details"

             x:DataType="jsModel:FilesNode"
             Foreground="{Binding Path=Color, Converter={StaticResource ContrastBrushConverter}}"
             >
  <Design.DataContext>
    <jsModel:FilesNode/>
  </Design.DataContext>

  <UserControl.Resources>
    <converters:ColorToBrushConverter x:Key="ToBrushConverter"/>
  </UserControl.Resources>

  <!-- Room on the right for the name and path ports, while going through files one at a time -->
  <UserControl.Styles>
    <Style Selector="StackPanel.summary">
      <Setter Property="Margin" Value="10 4 10 4"/>
    </Style>
    <Style Selector="StackPanel.summary.each">
      <Setter Property="Margin" Value="10 4 48 4"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{Binding Path=Color, Converter={StaticResource ToBrushConverter}}"
          Classes="node"
          Classes.selected="{Binding Path=IsSelected}"
          Classes.running="{Binding Path=IsRunning}"
          >
    <Grid RowDefinitions="30,28,*"
          ColumnDefinitions="40,*">

      <TextBlock Grid.Column="0"
                 Grid.Row="0"
                 Grid.RowSpan="2"
                 Classes="glyph"
                 Text="∀"
                 ToolTip.Tip="Files in a folder: all together, read one at a time by a Map, or given one at a time, the nodes after them worked out again for each (see its edit panel)"
                 />

      <StackPanel Grid.Row="0"
                  Grid.Column="1"
                  Classes="nodeActions">

        <jsControls:ResultBadge/>

        <TextBlock Text="⚠"
                   VerticalAlignment="Center"
                   Margin="0 0 4 0"
                   Foreground="{StaticResource NodeWarningBrush}"
                   IsVisible="{Binding Path=Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                   ToolTip.Tip="{Binding Path=Error}"
                   />

        <Button Classes="nodeAction"
                Content="Ξ"
                ToolTip.Tip="Edit"
              >
          <Button.Flyout>
            <Flyout Placement="Top"
                    ShowMode="Transient"
                    >
              <jsDetails:FilesNode/>
            </Flyout>
          </Button.Flyout>
        </Button>

        <TextBlock Classes="nodeInfo"
                   Text="𝑖"
                   >
          <ToolTip.Tip>
            <TextBlock FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                       TextAlignment="Left"
                       TextWrapping="Wrap"
                       MaxWidth="480"
                       Text="{Binding Path=Code}"/>
          </ToolTip.Tip>
        </TextBlock>

        <Button Classes="nodeAction danger"
                Content="✕"
                ToolTip.Tip="Delete"
                Click="Delete_Click"
                />

      </StackPanel>

      <jsControls:Connector Grid.Row="1"
                     Grid.Column="1"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     ZIndex="3"
                     Margin="0 0 -8 0"/>

      <!-- Folder and pattern, e.g. "runs *.csv" -->
      <StackPanel Grid.Row="1"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="4 0 8 0"
                  ToolTip.Tip="{Binding Path=Folder}"
                  >
        <TextBlock FontSize="16"
                   MaxWidth="80"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding Path=FolderName}"
                   />
        <TextBlock Classes="caption"
                   VerticalAlignment="Bottom"
                   Margin="4 0 0 2"
                   MaxWidth="56"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding Path=Pattern}"
                   />
      </StackPanel>

      <!-- Which files, and what each becomes -->
      <StackPanel Grid.Row="2"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Classes="summary"
                  Classes.each="{Binding Path=EachFile}"
                  >
        <TextBlock FontSize="12"
                   TextWrapping="Wrap"
                   MaxLines="2"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding Path=Summary}"
                   ToolTip.Tip="{Binding Path=Summary}"
                   />
        <TextBlock Classes="caption"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding Path=EachText}"
                   />
      </StackPanel>

      <!-- The file's name and path, while going through files one at a time -->
      <StackPanel Grid.Row="2"
                  Grid.Column="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0 4 0 0"
                  IsVisible="{Binding Path=EachFile}"
                  >
        <Grid Height="18"
              ToolTip.Tip="The name of the file it is at: often when it was written, as sensors name their files by the time."
              >
          <TextBlock Classes="caption"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Margin="0 0 14 0"
                     Text="name"
                     />
          <jsControls:Connector HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ZIndex="3"
                                Margin="0 0 -8 0"
                                Output="name"
                                />
        </Grid>
        <Grid Height="18"
              ToolTip.Tip="The whole path of the file it is at: to open a file that goes with it, say a frame's marked twin in the same folder."
              >
          <TextBlock Classes="caption"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Margin="0 0 14 0"
                     Text="path"
                     />
          <jsControls:Connector HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                ZIndex="3"
                                Margin="0 0 -8 0"
                                Output="path"
                                />
        </Grid>
      </StackPanel>

    </Grid>
  </Border>
</UserControl>
