<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="JuliaSynth.Views.Inputs.Integer"

             xmlns:converters="clr-namespace:Avalonia.Markup.Xaml.Converters;assembly=Avalonia.Markup.Xaml"
             xmlns:jsModel ="clr-namespace:JuliaSynth.Model;assembly=JuliaSynth"
             xmlns:jsControls="clr-namespace:JuliaSynth.Controls"
             xmlns:jsDetails="clr-namespace:JuliaSynth.Views.Details"

             x:DataType="jsModel:Integer"
             Foreground="{Binding Path=Color, Converter={StaticResource ContrastBrushConverter}}"
             >
  <Design.DataContext>
    <jsModel:Integer/>
  </Design.DataContext>

  <UserControl.Resources>
    <converters:ColorToBrushConverter x:Key="ToBrushConverter"/>
  </UserControl.Resources>

  <Border Background="{Binding Path=Color, Converter={StaticResource ToBrushConverter}}"
          Classes="node"
          Classes.selected="{Binding Path=IsSelected}"
          >
    <Grid RowDefinitions="30,46,20,20"
          ColumnDefinitions="40,*">

      <TextBlock Grid.Column="0"
                 Grid.Row="0"
                 Grid.RowSpan="2"
                 Classes="glyph"
                 Text="𝑧"
                 />

      <TextBlock Grid.Column="0"
                 Grid.Row="2"
                 HorizontalAlignment="Right"
                 Classes="caption"
                 Text="Min"
                 />

      <TextBlock Grid.Column="0"
                 Grid.Row="3"
                 HorizontalAlignment="Right"
                 Classes="caption"
                 Text="Max"
                 />

      <StackPanel Grid.Row="0"
                  Grid.Column="1"
                  Classes="nodeActions">

        <jsControls:ResultBadge/>

        <Button Classes="nodeAction"
                Content="Ξ"
                ToolTip.Tip="Edit"
              >
          <Button.Flyout>
            <Flyout Placement="Top"
                    ShowMode="Transient"
                    >
              <jsDetails:Integer/>
            </Flyout>
          </Button.Flyout>
        </Button>

        <TextBlock Classes="nodeInfo"
                   Text="𝑖"
                   ToolTip.Tip="{Binding Path=SelectedType, StringFormat='Signed integer, {0}'}"
                   />

        <Button Classes="nodeAction danger"
                Content="✕"
                ToolTip.Tip="Delete"
                Click="Delete_Click"
                />

      </StackPanel>

      <jsControls:Connector Grid.Row="1"
                     Grid.Column="1"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     ZIndex="3"
                     Margin="0 0 -8 0"/>

      <TextBlock Grid.Row="1"
                 Grid.Column="1"
                 Classes="value"
                 Text="{Binding Path=Value, Converter={StaticResource CompactIntegerConverter}}"
                 ToolTip.Tip="{Binding Path=Value, StringFormat=\{0:N0\}}"
                 />

      <TextBlock Grid.Row="2"
                 Grid.Column="1"
                 Classes="limit"
                 Text="{Binding Path=Min, Converter={StaticResource CompactIntegerConverter}}"
                 ToolTip.Tip="{Binding Path=Min, StringFormat=\{0:N0\}}"
                 />

      <TextBlock Grid.Row="3"
                 Grid.Column="1"
                 Classes="limit"
                 Text="{Binding Path=Max, Converter={StaticResource CompactIntegerConverter}}"
                 ToolTip.Tip="{Binding Path=Max, StringFormat=\{0:N0\}}"
                 />

    </Grid>
  </Border>
</UserControl>
