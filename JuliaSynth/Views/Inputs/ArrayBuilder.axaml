<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="JuliaSynth.Views.Inputs.ArrayBuilder"

             xmlns:converters="clr-namespace:Avalonia.Markup.Xaml.Converters;assembly=Avalonia.Markup.Xaml"
             xmlns:jsModel ="clr-namespace:JuliaSynth.Model;assembly=JuliaSynth"
             xmlns:jsControls="clr-namespace:JuliaSynth.Controls"
             xmlns:jsDetails="clr-namespace:JuliaSynth.Views.Details"

             x:DataType="jsModel:ArrayBuilder"
             Foreground="{Binding Path=Color, Converter={StaticResource ContrastBrushConverter}}"
             >
  <Design.DataContext>
    <jsModel:ArrayBuilder/>
  </Design.DataContext>

  <UserControl.Resources>
    <converters:ColorToBrushConverter x:Key="ToBrushConverter"/>
  </UserControl.Resources>

  <Border Background="{Binding Path=Color, Converter={StaticResource ToBrushConverter}}"
          Classes="node"
          Classes.selected="{Binding Path=IsSelected}"
          Classes.running="{Binding Path=IsRunning}"
          >
    <Grid RowDefinitions="30,48,*"
          ColumnDefinitions="40,*">

      <TextBlock Grid.Column="0"
                 Grid.Row="0"
                 Grid.RowSpan="2"
                 Classes="glyph"
                 Text="{Binding Path=Symbol}"
                 />

      <StackPanel Grid.Row="0"
                  Grid.Column="1"
                  Classes="nodeActions">

        <jsControls:ResultBadge/>

        <TextBlock Text="⚠"
                   VerticalAlignment="Center"
                   Margin="0 0 4 0"
                   Foreground="{StaticResource NodeWarningBrush}"
                   IsVisible="{Binding Path=Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                   ToolTip.Tip="{Binding Path=Error}"
                   />

        <Button Classes="nodeAction"
                Content="Ξ"
                ToolTip.Tip="Edit"
              >
          <Button.Flyout>
            <Flyout Placement="Top"
                    ShowMode="Transient"
                    >
              <jsDetails:ArrayBuilder/>
            </Flyout>
          </Button.Flyout>
        </Button>

        <TextBlock Classes="nodeInfo"
                   Text="𝑖"
                   >
          <ToolTip.Tip>
            <TextBlock FontFamily="{StaticResource CodeFont}"
                       TextAlignment="Left"
                       Text="{Binding Path=Code}"/>
          </ToolTip.Tip>
        </TextBlock>

        <Button Classes="nodeAction danger"
                Content="✕"
                ToolTip.Tip="Delete"
                Click="Delete_Click"
                />

      </StackPanel>

      <!-- Output -->
      <jsControls:Connector Grid.Row="1"
                     Grid.Column="1"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     ZIndex="3"
                     Margin="0 0 -8 0"/>

      <!-- Next: the value it takes for the next file, when files are gone through one at a time -->
      <jsControls:Connector Grid.Row="1"
                     Grid.Column="0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     ZIndex="3"
                     Margin="-8 0 0 0"
                     Classes="next"
                     DataContext="{Binding Path=Next}"
                     ToolTip.Tip="next: going through files one at a time, this takes the value wired here after each file, as C = update(C, X) in a loop. It starts with its own."/>

      <!-- What it makes, e.g. "100×100, sparse 1%" above "sprand Float64" -->
      <StackPanel Grid.Row="1"
                  Grid.Column="1"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="4 0 8 0"
                  ToolTip.Tip="{Binding Path=OutputType}"
                  >
        <TextBlock Classes="caption"
                   HorizontalAlignment="Right"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding Path=Summary}"
                   />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <TextBlock Classes="nodeTitle"
                     Text="{Binding Path=Kind}"
                     />
          <TextBlock Classes="caption"
                     VerticalAlignment="Bottom"
                     Margin="4 0 0 2"
                     Text="{Binding Path=ElementType}"
                     />
        </StackPanel>
      </StackPanel>

      <!-- Inputs, one per argument -->
      <ItemsControl Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    ItemsSource="{Binding Path=Parameters}"
                    ClipToBounds="False"
                    >
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="jsModel:Argument">
            <Grid Height="20">
              <jsControls:Connector HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ZIndex="3"
                                    Margin="-8 0 0 0"/>
              <TextBlock HorizontalAlignment="Left"
                         Margin="16 0 8 0"
                         Classes="caption"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Path=Label}"
                         ToolTip.Tip="{Binding Path=Signature}"
                         />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </Grid>
  </Border>
</UserControl>
