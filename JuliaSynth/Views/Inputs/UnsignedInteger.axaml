<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="JuliaSynth.Views.Inputs.UnsignedInteger"
             xmlns:converters="clr-namespace:Avalonia.Markup.Xaml.Converters;assembly=Avalonia.Markup.Xaml"
             xmlns:jsvmi="clr-namespace:JuliaSynth.ViewModels.Inputs"
             xmlns:jsc="clr-namespace:JuliaSynth.Controls"
             xmlns:jsdetails="clr-namespace:JuliaSynth.Views.Details"
             x:DataType="jsvmi:UnsignedIntegerViewModel"
             ZIndex="1"
             Width="180"
             Height="120"
             ClipToBounds="False"
             >
  <UserControl.DataContext>
    <jsvmi:UnsignedIntegerViewModel/>
  </UserControl.DataContext>
  
  <UserControl.Resources>
    <converters:ColorToBrushConverter x:Key="ToBrushConverter"/>
  </UserControl.Resources>

  <Border Background="{Binding Path=Color, Converter={StaticResource ToBrushConverter}}"
          CornerRadius="8"
          BoxShadow="100 100 400 0 Black"
          BorderBrush="Black"
          BorderThickness="1"
          >
    <Grid ShowGridLines="False">

      <Grid.RowDefinitions>
        <RowDefinition Height="30"/>
        <RowDefinition Height="50"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="20"/>
      </Grid.RowDefinitions>

      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Grid.Row="0"
                 Grid.RowSpan="4"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 FontFamily="{StaticResource NotoSansMath}"
                 FontSize="64"
                 Text="𝑛"
                 />

      <TextBlock Grid.Column="0"
                 Grid.Row="2"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 FontFamily="{StaticResource NotoSansMath}"
                 FontStyle="Italic"
                 FontSize="12"
                 Text="Min"
                 />

      <TextBlock Grid.Column="0"
                 Grid.Row="3"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 FontFamily="{StaticResource NotoSansMath}"
                 FontStyle="Italic"
                 FontSize="12"
                 Text="Max"
                 />

      <StackPanel Grid.Row="0"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
        
        <Button Content="Ξ"
                FontFamily="{StaticResource NotoSansMath}"
              >
          <Button.Flyout>
            <Flyout Placement="Top"
                    ShowMode="Transient"
                    >
              <jsdetails:UnsignedInteger/>
            </Flyout>
          </Button.Flyout>
        </Button>
        
        <Button Content="𝑖"
                FontFamily="{StaticResource NotoSansMath}"
              />
        
        <Button Content="X"
                FontFamily="{StaticResource NotoSansMath}"
                />
        
      </StackPanel>
      
      <jsc:Connector Grid.Row="1"
                     Grid.Column="1"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     ZIndex="3"
                     Margin="0 0 -12 0"/>

      <TextBlock Grid.Row="1"
                 Grid.Column="1"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 FontSize="24"
                 Text="{Binding Path=Value, StringFormat=\{0:N0\}}"
                 ToolTip.Tip="{Binding Path=Value, StringFormat=\{0:N0\}}"
                 />

      <TextBlock Grid.Row="2"
                 Grid.Column="1"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Text="{Binding Path=Min, StringFormat=\{0:N0\}}"
                 ToolTip.Tip="{Binding Path=Min, StringFormat=\{0:N0\}}"
                 />

      <TextBlock Grid.Row="3"
                 Grid.Column="1"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Text="{Binding Path=Max, StringFormat=\{0:N0\}}"
                 ToolTip.Tip="{Binding Path=Max, StringFormat=\{0:N0\}}"
                 />

    </Grid>
  </Border>
</UserControl>
