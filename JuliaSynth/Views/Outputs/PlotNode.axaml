<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JuliaSynth.Views.Outputs.PlotNode"

             xmlns:converters="clr-namespace:Avalonia.Markup.Xaml.Converters;assembly=Avalonia.Markup.Xaml"
             xmlns:jsModel ="clr-namespace:JuliaSynth.Model;assembly=JuliaSynth"
             xmlns:jsControls="clr-namespace:JuliaSynth.Controls"
             xmlns:jsDetails="clr-namespace:JuliaSynth.Views.Details"
             xmlns:scottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"

             x:DataType="jsModel:PlotNode"
             Foreground="{Binding Path=Color, Converter={StaticResource ContrastBrushConverter}}"
             >
  <Design.DataContext>
    <jsModel:PlotNode/>
  </Design.DataContext>

  <UserControl.Resources>
    <converters:ColorToBrushConverter x:Key="ToBrushConverter"/>
  </UserControl.Resources>

  <Border Background="{Binding Path=Color, Converter={StaticResource ToBrushConverter}}"
          Classes="node"
          Classes.selected="{Binding Path=IsSelected}"
          >
    <Grid RowDefinitions="30,24,Auto,*"
          ColumnDefinitions="40,*">

      <TextBlock Grid.Column="0"
                 Grid.Row="0"
                 Grid.RowSpan="2"
                 Classes="glyph"
                 Text="∿"
                 ToolTip.Tip="Plot: draws the values wired in"
                 />

      <StackPanel Grid.Row="0"
                  Grid.Column="1"
                  Classes="nodeActions">

        <jsControls:ResultBadge/>

        <Button Classes="nodeAction"
                Content="⤢"
                ToolTip.Tip="Open larger, to zoom and pan"
                IsEnabled="{Binding Path=Plot, Converter={x:Static ObjectConverters.IsNotNull}}"
                Click="OpenLarger_Click"
                />

        <Button Classes="nodeAction"
                Content="Ξ"
                ToolTip.Tip="Edit"
              >
          <Button.Flyout>
            <Flyout Placement="Top"
                    ShowMode="Transient"
                    >
              <jsDetails:PlotNode/>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button Classes="nodeAction danger"
                Content="✕"
                ToolTip.Tip="Delete"
                Click="Delete_Click"
                />

      </StackPanel>

      <!-- The kind of plot -->
      <TextBlock Grid.Row="1"
                 Grid.Column="1"
                 VerticalAlignment="Bottom"
                 HorizontalAlignment="Right"
                 Margin="8 0 10 0"
                 Classes="caption"
                 Text="{Binding Path=Kind}"
                 />

      <!-- The inputs: y, and x for lines and points -->
      <ItemsControl Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    ItemsSource="{Binding Path=Inputs}"
                    ClipToBounds="False"
                    >
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="jsModel:Parameter">
            <Grid Height="20">
              <jsControls:Connector HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ZIndex="3"
                                    Margin="-8 0 0 0"/>
              <TextBlock HorizontalAlignment="Left"
                         Margin="16 0 8 0"
                         Classes="caption"
                         Text="{Binding Path=Signature}"
                         />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- The plot, or why there is none -->
      <Border Grid.Row="3"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Margin="6 2 6 6"
              CornerRadius="4"
              Background="{StaticResource NodeInsetBrush}"
              ClipToBounds="True"
              >
        <Panel>
          <scottPlot:AvaPlot x:Name="Chart"
                             IsVisible="{Binding Path=Plot, Converter={x:Static ObjectConverters.IsNotNull}}"
                             />
          <TextBlock Margin="8 6"
                     FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Opacity="0.8"
                     Text="{Binding Path=Message}"
                     IsVisible="{Binding Path=Message, Converter={x:Static ObjectConverters.IsNotNull}}"
                     />
        </Panel>
      </Border>

    </Grid>
  </Border>
</UserControl>
