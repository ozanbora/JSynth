<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JuliaSynth.Views.Outputs.DisplayNode"

             xmlns:converters="clr-namespace:Avalonia.Markup.Xaml.Converters;assembly=Avalonia.Markup.Xaml"
             xmlns:jsModel ="clr-namespace:JuliaSynth.Model;assembly=JuliaSynth"
             xmlns:jsControls="clr-namespace:JuliaSynth.Controls"

             x:DataType="jsModel:DisplayNode"
             Foreground="{Binding Path=Color, Converter={StaticResource ContrastBrushConverter}}"
             >
  <Design.DataContext>
    <jsModel:DisplayNode/>
  </Design.DataContext>

  <UserControl.Resources>
    <converters:ColorToBrushConverter x:Key="ToBrushConverter"/>
  </UserControl.Resources>

  <Border Background="{Binding Path=Color, Converter={StaticResource ToBrushConverter}}"
          Classes="node"
          Classes.selected="{Binding Path=IsSelected}"
          >
    <Grid RowDefinitions="30,24,22,*"
          ColumnDefinitions="40,*">

      <TextBlock Grid.Column="0"
                 Grid.Row="0"
                 Grid.RowSpan="2"
                 Classes="glyph"
                 Text="="
                 ToolTip.Tip="Display: shows the value wired in"
                 />

      <StackPanel Grid.Row="0"
                  Grid.Column="1"
                  Classes="nodeActions">

        <jsControls:ResultBadge/>

        <Button Classes="nodeAction danger"
                Content="✕"
                ToolTip.Tip="Delete"
                Click="Delete_Click"
                />

      </StackPanel>

      <!-- The input -->
      <ItemsControl Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    ItemsSource="{Binding Path=Inputs}"
                    ClipToBounds="False"
                    >
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="jsModel:Parameter">
            <Grid Height="22">
              <jsControls:Connector HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ZIndex="3"
                                    Margin="-8 0 0 0"/>
              <TextBlock HorizontalAlignment="Left"
                         Margin="16 0 8 0"
                         Classes="caption"
                         Text="{Binding Path=Name}"
                         />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- The type of the value shown -->
      <TextBlock Grid.Row="1"
                 VerticalAlignment="Bottom"
                 Grid.Column="1"
                 HorizontalAlignment="Right"
                 Margin="8 0 10 0"
                 Classes="caption"
                 TextTrimming="{x:Static jsControls:Trimming.Dots}"
                 Text="{Binding Path=ShownType}"
                 />

      <!-- The value, as Julia shows it -->
      <Border Grid.Row="3"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Margin="8 2 8 8"
              Padding="6 4"
              CornerRadius="4"
              Background="#33000000"
              ClipToBounds="True"
              >
        <TextBlock FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                   FontSize="11"
                   TextWrapping="NoWrap"
                   FontStyle="{Binding Path=IsShownError, Converter={x:Static jsControls:ResultStyles.ItalicWhenTrue}}"
                   Opacity="{Binding Path=HasResult, Converter={x:Static jsControls:ResultStyles.DimWhenFalse}}"
                   Text="{Binding Path=Shown}"
                   ToolTip.Tip="{Binding Path=Shown}"
                   />
      </Border>

    </Grid>
  </Border>
</UserControl>
