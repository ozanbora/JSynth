<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JuliaSynth.Views.FileNameNode"

             xmlns:converters="clr-namespace:Avalonia.Markup.Xaml.Converters;assembly=Avalonia.Markup.Xaml"
             xmlns:jsModel ="clr-namespace:JuliaSynth.Model;assembly=JuliaSynth"
             xmlns:jsControls="clr-namespace:JuliaSynth.Controls"

             x:DataType="jsModel:FileNameNode"
             Foreground="{Binding Path=Color, Converter={StaticResource ContrastBrushConverter}}"
             >
  <Design.DataContext>
    <jsModel:FileNameNode />
  </Design.DataContext>

  <UserControl.Resources>
    <converters:ColorToBrushConverter x:Key="ToBrushConverter"/>
  </UserControl.Resources>

  <Border Background="{Binding Path=Color, Converter={StaticResource ToBrushConverter}}"
          Classes="node"
          Classes.selected="{Binding Path=IsSelected}"
          >
    <Grid RowDefinitions="30,46,*"
          ColumnDefinitions="40,*">

      <TextBlock Grid.Column="0"
                 Grid.Row="0"
                 Grid.RowSpan="2"
                 Classes="glyph"
                 Text="“”"
                 />

      <StackPanel Grid.Row="0"
                  Grid.Column="1"
                  Classes="nodeActions">

        <jsControls:ResultBadge/>

        <Button Classes="nodeAction"
                Content="⇄"
                Click="Toggle_Click"
                ToolTip.Tip="file name: the name of the file a loop is at. file path: its whole path, to open a file that goes with it. Click to switch."
                />

        <TextBlock Classes="nodeInfo"
                   Text="𝑖"
                   >
          <ToolTip.Tip>
            <TextBlock TextWrapping="Wrap"
                       MaxWidth="360"
                       Text="File name: the name of the file being gone through, while a Files node set to one file at a time, or a Watch folder, goes through its files. Sensors often name their files by the time they were written."/>
          </ToolTip.Tip>
        </TextBlock>

        <Button Classes="nodeAction danger"
                Content="✕"
                ToolTip.Tip="Delete"
                Click="Delete_Click"
                />

      </StackPanel>

      <jsControls:Connector Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ZIndex="3"
                            Margin="0 0 -8 0"/>

      <DockPanel Grid.Row="1"
                 Grid.Column="1"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="4 0 8 0"
                 >
        <TextBlock DockPanel.Dock="Left"
                   FontSize="18"
                   Text="{Binding Path=Label}"
                   />
        <TextBlock Classes="caption"
                   VerticalAlignment="Bottom"
                   Margin="4 0 0 2"
                   Text="{Binding Path=OutputType}"
                   />
      </DockPanel>

      <TextBlock Grid.Row="2"
                 Grid.Column="0"
                 Grid.ColumnSpan="2"
                 Margin="10 4 10 4"
                 Classes="caption"
                 TextWrapping="Wrap"
                 Text="of the file a loop is at"
                 />

    </Grid>
  </Border>

</UserControl>
