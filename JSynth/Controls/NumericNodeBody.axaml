<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JSynth.Controls.NumericNodeBody"

             xmlns:converters="clr-namespace:Avalonia.Markup.Xaml.Converters;assembly=Avalonia.Markup.Xaml"
             xmlns:jsModel ="clr-namespace:JSynth.Model;assembly=JSynth"
             xmlns:jsControls="clr-namespace:JSynth.Controls"
             xmlns:jsConverters="clr-namespace:JSynth.Converters"

             x:DataType="jsModel:Node"
             Foreground="{Binding Path=Color, Converter={StaticResource ContrastBrushConverter}}"
             >

  <UserControl.Resources>
    <converters:ColorToBrushConverter x:Key="ToBrushConverter"/>
    <jsConverters:NodeNumberConverter x:Key="NumberConverter"/>
  </UserControl.Resources>

  <Border Background="{Binding Path=Color, Converter={StaticResource ToBrushConverter}}"
          Classes="node"
          Classes.selected="{Binding Path=IsSelected}"
          Classes.running="{Binding Path=IsRunning}"
          >
    <Grid RowDefinitions="30,46,20,20"
          ColumnDefinitions="40,*">

      <TextBlock Grid.Column="0"
                 Grid.Row="0"
                 Grid.RowSpan="2"
                 Classes="glyph"
                 Text="{Binding $parent[jsControls:NumericNodeBody].Glyph}"
                 />

      <TextBlock Grid.Column="0"
                 Grid.Row="2"
                 HorizontalAlignment="Right"
                 Classes="caption"
                 Text="Min"
                 />

      <TextBlock Grid.Column="0"
                 Grid.Row="3"
                 HorizontalAlignment="Right"
                 Classes="caption"
                 Text="Max"
                 />

      <StackPanel Grid.Row="0"
                  Grid.Column="1"
                  Classes="nodeActions">

        <TextBlock Text="◆"
                   FontSize="10"
                   Opacity="0.7"
                   Margin="0 0 4 0"
                   VerticalAlignment="Center"
                   IsVisible="{Binding Path=InPanel}"
                   ToolTip.Tip="In the parameters panel"/>
        <jsControls:ResultBadge/>

        <!-- The flyout isn't in the visual tree, so its content (Details) is set from the code. -->
        <Button x:Name="EditButton"
                Classes="nodeAction"
                Content="Ξ"
                ToolTip.Tip="Edit"
              >
          <Button.Flyout>
            <Flyout Placement="Top"
                    ShowMode="Transient"
                    />
          </Button.Flyout>
        </Button>

        <!-- "Floating-point number, 32-bit" -->
        <TextBlock Classes="nodeInfo"
                   Text="𝑖"
                   >
          <ToolTip.Tip>
            <TextBlock>
              <Run Text="{Binding $parent[jsControls:NumericNodeBody].Kind}"/><Run Text=", "/><Run Text="{ReflectionBinding Path=SelectedType}"/>
            </TextBlock>
          </ToolTip.Tip>
        </TextBlock>

        <Button Classes="nodeAction danger"
                Content="✕"
                ToolTip.Tip="Delete"
                Click="Delete_Click"
                />

      </StackPanel>

      <jsControls:Connector Grid.Row="1"
                     Grid.Column="1"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     ZIndex="3"
                     Margin="0 0 -8 0"/>

      <!-- Next: the value it takes for the next file, when files are gone through one at a time -->
      <jsControls:Connector Grid.Row="1"
                     Grid.Column="0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     ZIndex="3"
                     Margin="-8 0 0 0"
                     Classes="next"
                     DataContext="{Binding Path=Next}"
                     ToolTip.Tip="next: going through files one at a time, this takes the value wired here after each file, as C = update(C, X) in a loop. It starts with its own."/>

      <!-- Its name: the one given (its variable in the script), or the parameter it is wired into. -->
      <jsControls:InputLabel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="6 4 8 0"/>

      <!-- Value, Min and Max are on NumericInput<T>, which a compiled binding can't name: reflection bindings. -->
      <TextBlock Grid.Row="1"
                 Grid.Column="1"
                 Classes="value"
                 Text="{ReflectionBinding Path=Value, Converter={StaticResource NumberConverter}}"
                 ToolTip.Tip="{ReflectionBinding Path=Value, Converter={StaticResource NumberConverter}, ConverterParameter=full}"
                 />

      <TextBlock Grid.Row="2"
                 Grid.Column="1"
                 Classes="limit"
                 Text="{ReflectionBinding Path=Min, Converter={StaticResource NumberConverter}}"
                 ToolTip.Tip="{ReflectionBinding Path=Min, Converter={StaticResource NumberConverter}, ConverterParameter=full}"
                 />

      <TextBlock Grid.Row="3"
                 Grid.Column="1"
                 Classes="limit"
                 Text="{ReflectionBinding Path=Max, Converter={StaticResource NumberConverter}}"
                 ToolTip.Tip="{ReflectionBinding Path=Max, Converter={StaticResource NumberConverter}, ConverterParameter=full}"
                 />

    </Grid>
  </Border>
</UserControl>
