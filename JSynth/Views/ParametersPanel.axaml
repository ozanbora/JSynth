<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JSynth.Views.ParametersPanel"

             xmlns:jsViewModels="clr-namespace:JSynth.ViewModels"

             x:DataType="jsViewModels:MainViewModel"
             >
  <!-- The inputs put in the panel: sliders and boxes, the design running again a moment after each change. -->
  <UserControl.Styles>
    <Style Selector="TextBox.name">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0 2"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="TextBox.range">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="20"/>
    </Style>
    <Style Selector="TextBox.value">
      <Setter Property="FontFamily" Value="{DynamicResource CodeFont}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </UserControl.Styles>

  <DockPanel Width="300">
    <Grid DockPanel.Dock="Top"
          ColumnDefinitions="*,Auto"
          Margin="14 2 4 0">
      <TextBlock Classes="panelTitle"
                 Text="Parameters"/>
      <Button Grid.Column="1"
              Classes="quiet"
              Content="✕"
              Command="{Binding Path=ToggleParameters}"
              ToolTip.Tip="Close the parameters"/>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom"
                Margin="14 8 14 12"
                Spacing="6">
      <CheckBox Content="Run when a value changes"
                IsChecked="{Binding Path=RunOnChange}"
                ToolTip.Tip="Run the design again a moment after a value here changes"/>
      <SelectableTextBlock Text="{Binding Path=ParameterResults}"
                           FontFamily="{StaticResource CodeFont}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
    </StackPanel>

    <Panel>
      <TextBlock Margin="14 8"
                 TextWrapping="Wrap"
                 Classes="secondary"
                 IsVisible="{Binding !HasParameters}"
                 Text="Put a number, an array or a folder here with Show in parameters, in its Ξ menu."/>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Path=Parameters}"
                      Margin="14 0 14 8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="jsViewModels:PanelParameter">
              <StackPanel Margin="0 6 0 10" Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Classes="name"
                           Text="{Binding Path=Name, UpdateSourceTrigger=LostFocus}"
                           ToolTip.Tip="Its name here: click to change it"/>
                  <TextBlock Grid.Column="1"
                             FontSize="11"
                             Classes="secondary"
                             VerticalAlignment="Center"
                             Margin="8 0 0 0"
                             MaxWidth="170"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding Path=Source}"
                             ToolTip.Tip="{Binding Path=Source}"/>
                </Grid>

                <!-- A number: a slider and a box. -->
                <StackPanel IsVisible="{Binding Path=IsNumber}" Spacing="0">
                  <Grid ColumnDefinitions="*,96">
                    <Slider Minimum="0"
                            Maximum="{x:Static jsViewModels:PanelParameter.SliderScale}"
                            Value="{Binding Path=SliderPosition}"
                            Margin="0 -6 10 -6"/>
                    <TextBox Grid.Column="1"
                             Classes="value"
                             HorizontalContentAlignment="Right"
                             VerticalAlignment="Center"
                             Text="{Binding Path=NumberText, UpdateSourceTrigger=LostFocus}"/>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0 0 106 0">
                    <TextBox Classes="range"
                             Text="{Binding Path=FromText, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="Where the slider starts"/>
                    <TextBox Grid.Column="2"
                             Classes="range"
                             HorizontalContentAlignment="Right"
                             Text="{Binding Path=ToText, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="Where the slider ends"/>
                  </Grid>
                </StackPanel>

                <!-- An array: its values as typed. -->
                <TextBox Classes="value"
                         IsVisible="{Binding Path=IsArray}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="48"
                         MaxHeight="160"
                         Text="{Binding Path=Text, UpdateSourceTrigger=LostFocus}"
                         ToolTip.Tip="The values, as on the node: changed once you leave the box"/>

                <!-- A folder: its path, and a button to pick another. -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Path=IsFolder}">
                  <TextBox Classes="value"
                           Text="{Binding Path=Text, UpdateSourceTrigger=LostFocus}"/>
                  <Button Grid.Column="1"
                          Margin="6 0 0 0"
                          Content="…"
                          ToolTip.Tip="Pick the folder"
                          Click="PickFolder_Click"/>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
