<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JSynth.Views.Inputs.Float"

             xmlns:jsModel ="clr-namespace:JSynth.Model;assembly=JSynth"
             xmlns:jsControls="clr-namespace:JSynth.Controls"
             xmlns:jsDetails="clr-namespace:JSynth.Views.Details"

             x:DataType="jsModel:Float"
             >
  <Design.DataContext>
    <jsModel:Float/>
  </Design.DataContext>

  <jsControls:NumericNodeBody Glyph="𝑥"
                              Kind="Floating-point number"
                              >
    <jsControls:NumericNodeBody.Details>
      <jsDetails:Float/>
    </jsControls:NumericNodeBody.Details>
  </jsControls:NumericNodeBody>
</UserControl>
