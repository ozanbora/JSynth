<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JSynth.Views.Inputs.UnsignedInteger"

             xmlns:jsModel ="clr-namespace:JSynth.Model;assembly=JSynth"
             xmlns:jsControls="clr-namespace:JSynth.Controls"
             xmlns:jsDetails="clr-namespace:JSynth.Views.Details"

             x:DataType="jsModel:UnsignedInteger"
             >
  <Design.DataContext>
    <jsModel:UnsignedInteger/>
  </Design.DataContext>

  <jsControls:NumericNodeBody Glyph="𝑛"
                              Kind="Unsigned integer"
                              >
    <jsControls:NumericNodeBody.Details>
      <jsDetails:UnsignedInteger/>
    </jsControls:NumericNodeBody.Details>
  </jsControls:NumericNodeBody>
</UserControl>
