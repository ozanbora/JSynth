<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JSynth.Views.MergeNode"

             xmlns:jsModel ="clr-namespace:JSynth.Model;assembly=JSynth"
             xmlns:jsControls="clr-namespace:JSynth.Controls"

             x:DataType="jsModel:MergeNode"
             >
  <Design.DataContext>
    <jsModel:MergeNode />
  </Design.DataContext>

  <!-- Input: the folders, all wired to its one port -->
  <jsControls:NodeBody Glyph="∪"
                       Title="merge"
                       Info="Merge: several streams as one. Wire folders going through their files one at a time (Files nodes or Watch folders) all to its one port: their files are gone through together, in name order (by time, when named by it; for the same name, the folder higher on the canvas first), or as they are written when watched. It gives the file just come, whichever folder it is in, and on its folder output the name of that folder. Each folder's own value is its latest file, so a node wired from a folder works with the latest it has, e.g. a storm's latest position for each tide gauge reading; before a folder's first file, the nodes after it wait."
                       >
    <!-- Second output: the name of the folder the file is in -->
    <jsControls:NodeBody.Extra>
      <Grid Height="20"
            VerticalAlignment="Top"
            >
        <TextBlock HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0 0 16 0"
                   Classes="caption"
                   Text="folder: String"
                   ToolTip.Tip="The name of the folder the file just come is in, e.g. Cedar Key: to tell which stream it came from."
                   />
        <jsControls:Connector HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              ZIndex="3"
                              Margin="0 0 -8 0"
                              Output="folder"
                              />
      </Grid>
    </jsControls:NodeBody.Extra>
  </jsControls:NodeBody>

</UserControl>
