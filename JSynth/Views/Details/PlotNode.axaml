<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             x:Class="JSynth.Views.Details.PlotNode"
             Classes="details"

             xmlns:jsModel ="clr-namespace:JSynth.Model;assembly=JSynth"
             xmlns:jsConverters="clr-namespace:JSynth.Converters"

             x:DataType="jsModel:PlotNode"
             Width="420"

             mc:Ignorable="d"
             d:DesignHeight="200"
             >

  <Design.DataContext>
    <jsModel:PlotNode />
  </Design.DataContext>

  <UserControl.Resources>
    <jsConverters:DecimalToLongConverter x:Key="DecimalConverter"/>
  </UserControl.Resources>

  <Grid RowDefinitions="auto,auto,auto,auto"
        ColumnDefinitions="auto,*"
        >

    <Label Grid.Row="0"
           Grid.Column="0"
           VerticalAlignment="Center"
           Content="Kind"
           />
    <StackPanel Grid.Row="0"
                Grid.Column="1"
                Orientation="Horizontal"
                >
      <ComboBox Width="130"
                SelectedValue="{Binding Path=Kind}"
                ItemsSource="{x:Static jsModel:PlotNode.Kinds}"
                VerticalAlignment="Center"
                ToolTip.Tip="Auto: a line for a vector, dots for a sparse matrix, a heatmap for another matrix. Histogram: a vector's values counted into bins."
                />

      <Label Content="Color" VerticalAlignment="Center"/>
      <ColorPicker Color="{Binding Path=Color}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   ToolTip.Tip="Select the color you want to display this node."
                   />
    </StackPanel>

    <Label Grid.Row="1"
           Grid.Column="0"
           VerticalAlignment="Center"
           Content="Title"
           />
    <TextBox Grid.Row="1"
             Grid.Column="1"
             Text="{Binding Path=Title}"
             PlaceholderText="(none)"
             ToolTip.Tip="Shown above the plot."
             />

    <Label Grid.Row="2"
           Grid.Column="0"
           VerticalAlignment="Center"
           Content="Bins"
           IsVisible="{Binding Path=IsHistogram}"
           />
    <StackPanel Grid.Row="2"
                Grid.Column="1"
                Orientation="Horizontal"
                IsVisible="{Binding Path=IsHistogram}"
                >
      <NumericUpDown Width="130"
                     Minimum="0"
                     Maximum="10000"
                     Increment="1"
                     ClipValueToMinMax="True"
                     FormatString="0"
                     Value="{Binding Path=Bins, Converter={StaticResource DecimalConverter}}"
                     ToolTip.Tip="How many equal bins, from the smallest value to the largest, to count the values into."
                     />
      <TextBlock VerticalAlignment="Center" Margin="6 0 0 0" Text="(0: auto, √n up to 200)"/>
    </StackPanel>

    <TextBlock Grid.Row="3"
               Grid.Column="1"
               Margin="0 6 0 0"
               FontSize="12"
               Opacity="0.7"
               TextWrapping="Wrap"
               Text="Wire a vector into y for a line, points or bars, against x if you wire one in (otherwise 1, 2, 3, …), or to count its values in a histogram; a matrix for a heatmap, or dots where a sparse matrix has values. Big matrices are averaged down to 1000 × 1000 for the heatmap."
               />
  </Grid>

</UserControl>
