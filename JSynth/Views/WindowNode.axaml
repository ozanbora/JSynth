<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JSynth.Views.WindowNode"

             xmlns:jsModel ="clr-namespace:JSynth.Model;assembly=JSynth"
             xmlns:jsControls="clr-namespace:JSynth.Controls"
             xmlns:jsConverters="clr-namespace:JSynth.Converters"

             x:DataType="jsModel:WindowNode"
             >
  <Design.DataContext>
    <jsModel:WindowNode />
  </Design.DataContext>

  <UserControl.Resources>
    <jsConverters:DecimalToLongConverter x:Key="DecimalConverter"/>
  </UserControl.Resources>

  <jsControls:NodeBody Glyph="⧗"
                       Title="{Binding Path=SizeText}"
                       Info="Window: the last values wired into value, oldest first, as a vector. Going through files one at a time, those of the last few files: e.g. the mean of the last 6 strengths of a vibration, smoothing out one-off spikes."
                       >
    <jsControls:NodeBody.Actions>
      <Button Classes="nodeAction"
              Content="Ξ"
              ToolTip.Tip="Edit"
              >
        <Button.Flyout>
          <Flyout Placement="Top"
                  ShowMode="Transient"
                  >
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Label VerticalAlignment="Center" Content="Keep the last"/>
              <NumericUpDown x:Name="SizeBox"
                             Width="130"
                             Minimum="1"
                             Maximum="1000000"
                             Increment="1"
                             FormatString="0"
                             Value="{Binding Path=Size, Converter={StaticResource DecimalConverter}}"
                             ToolTip.Tip="How many of the last values it keeps: going through files one at a time, those of the last files."
                             />
              <Label VerticalAlignment="Center" Content="values"/>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </jsControls:NodeBody.Actions>
  </jsControls:NodeBody>

</UserControl>
